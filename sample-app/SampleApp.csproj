<Project Sdk="Microsoft.NET.Sdk">
  <!-- 配信番のサンプル：WinForms の小さなアプリ（架空の「在庫管理」）。UpdateSafetyKit と報告の送り手を組み込む。外部パッケージ 0。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <AssemblyName>SampleApp</AssemblyName>
    <RootNamespace>HaishinSample</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\csharp\UpdateSafetyKit\UpdateSafetyKit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="sampleapp.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
